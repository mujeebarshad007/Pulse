{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": ".backend-build",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/server/**/*.ts", "tests/backend/**/*.ts"]
}
