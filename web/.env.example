# Backend CLI reads .env.local through Node's --env-file-if-exists option.
# Use the local database script to avoid passwords during local synthetic testing.
# Never use NEXT_PUBLIC_ for database or storage secrets.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/REPLACE_DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=10

# connected (default) uses server sessions/database. demo uses fictional memory only.
APP_MODE=connected
BETTER_AUTH_URL=http://localhost:3000
# Generate privately; do not commit or paste the value into chat.
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Absolute, durable private directory OUTSIDE public/ and .next/.
# Leave unset locally to use web/.local/private-reports.
# PRIVATE_STORAGE_DIR=/var/lib/pulse/reports
